# Python bytecode (the CI/pre-commit `compileall` step writes these)
__pycache__/
*.py[cod]

# Local virtualenv, if one is ever created
.venv/

# Renderer output is regenerated by scripts/render_board_with_charts.py.
# `board-demo.png` is a committed demo artifact, so it stays.
output/*
!output/board-demo.png
