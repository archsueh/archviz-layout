{
  "kit": 1,
  "skill_md": "SKILL.md",
  "skill_md_max_bytes": 36000,
  "require_lf_pin": true,

  "version": {
    "changelog": "CHANGELOG.md"
  },

  "registries": {
    "visual_languages": {
      "kind": "source_regex",
      "file": "SKILL.md",
      "entry": "^\\* \\*\\*\\d+\\.\\s*([^\\n]+?[)）])",
      "flags": "M"
    }
  },

  "routing": {
    "registries": ["visual_languages"],
    "also_check_triggers": false
  },

  "counts": [
    {
      "id": "visual_languages",
      "truth": { "kind": "registry_len", "registry": "visual_languages" },
      "assertions": [
        { "file": "SKILL.md", "regex": "(\\d+)\\s*套视觉语言（visual languages" },
        { "file": "SKILL.md", "regex": "建筑版式\\s*(\\d+)\\s*套视觉语言" }
      ]
    },
    {
      "id": "reference_files",
      "truth": { "kind": "glob_count", "globs": ["references/*.md"] },
      "assertions": [
        { "file": "SKILL.md", "regex": "延伸规范（共\\s*(\\d+)\\s*个文件）" }
      ]
    }
  ],

  "coverage": [
    {
      "id": "reference_index",
      "indexed_in": "SKILL.md",
      "globs": ["references/*.md"]
    }
  ],

  "deps": {
    "requirements": "requirements.txt",
    "python_roots": ["scripts"],
    "self_packages": [],
    "map": { "PIL": "Pillow" }
  },

  "cjk": {
    "scan": [
      "SKILL.md",
      "README.md",
      "CHANGELOG.md",
      "design-md/*/DESIGN.md",
      "examples/*.html",
      "references/*.md"
    ],
    "require_charset": ["examples/*.html"]
  }
}
